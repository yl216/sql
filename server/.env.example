# 复制为 .env 后按本机情况修改
# 这些值只是本地练习环境的默认值，不要用在生产

DB_HOST=127.0.0.1
DB_PORT=3306

# 建库建表用，需要 CREATE DATABASE / CREATE USER 权限
DB_USER=root
DB_PASSWORD=

# 执行用户 SQL 的只读账号（由 npm run seed 自动创建）
DB_RO_USER=sqlprac_ro
DB_RO_PASSWORD=SqlPrac_ro_2026

# DML 沙盒的读写账号（由 npm run seed 自动创建）
DB_RW_USER=sqlprac_rw
DB_RW_PASSWORD=SqlPrac_rw_2026

PORT=3001
